APP_ENV=production
SECRET_KEY=generate_a_secure_random_key_here
CORS_ORIGINS=["https://your-frontend-domain.example"]

DATABASE_URL=postgresql://your_database_user:your_database_password@your_database_host/your_database
REDIS_URL=rediss://default:your_upstash_password@your_upstash_host:6379/0

# Storage
LOCAL_STORAGE_DIR=media

# AI Providers
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACES_TIMEOUT_SECONDS=20
GOOGLE_PLACES_MAX_SEARCH_PAGES=3

# Scraper Settings
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5
SCRAPER_TIMEOUT=30
SCRAPER_MAX_CONCURRENT=1
SCRAPER_COOLDOWN=60
SCRAPER_HEADLESS=true
SCRAPER_PROFILE_DIR=./.scraper_profiles
