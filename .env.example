DATABASE_URL=postgresql://user:password@localhost:5432/comp_intel
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=media

# AI Providers
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROK_API_KEY=

# Scraper Settings
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5
SCRAPER_TIMEOUT=30
SCRAPER_MAX_CONCURRENT=1
SCRAPER_COOLDOWN=60
SCRAPER_HEADLESS=true
SCRAPER_PROFILE_DIR=./.scraper_profiles
